NEXT_PUBLIC_SANITY_PROJECT_ID=am9ihg1w
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-24
SANITY_API_WRITE_TOKEN=
AUTH_SECRET=

# Optional. When a SEV1 escalation gets its 2nd approval, this URL gets a
# POST with { event, incidentId, incidentTitle, severity, summary,
# timestamp }. Leave unset to skip the call entirely (default). Point it at
# a Slack/Discord incoming webhook, or https://webhook.site for a quick demo.
STATUS_PAGE_WEBHOOK_URL=

# Optional. Powers the AI-drafted postmortem: resolving an incident (and the
# Studio's "Regenerate with AI" button on Root cause) calls Groq's
# openai/gpt-oss-120b to draft a root cause + action items from the frozen
# timeline. Leave unset to skip — the postmortem is just created blank, same
# as before. Get a free key at https://console.groq.com/keys.
GROQ_API_KEY=
